{
  "name": "@ubiquity-os/plugin-manifest-tool",
  "version": "0.1.0",
  "description": "CLI to generate UbiquityOS plugin manifest.json from plugin source code.",
  "license": "MIT",
  "author": "Ubiquity DAO",
  "type": "commonjs",
  "main": "./bin/plugin-manifest-tool.js",
  "bin": {
    "plugin-manifest-tool": "./bin/plugin-manifest-tool.js"
  },
  "files": [
    "bin",
    "README.md"
  ],
  "engines": {
    "node": ">=20.10.0",
    "bun": ">=1.0.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check": "run-s lint format test",
    "prepare": "husky",
    "sdk:build": "bun run check && npm pack --dry-run >/dev/null"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
